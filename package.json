{
  "name": "slayply",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "build": "turbo run build",
    "prepare": "node scripts/setup-hooks.mjs",
    "doctor": "node scripts/doctor.mjs",
    "check": "node scripts/check.mjs",
    "fmt": "biome format --write .",
    "fmt:check": "biome format .",
    "lint": "biome lint --error-on-warnings .",
    "test": "node scripts/test.mjs",
    "handoff:check": "node scripts/handoff-check.mjs",
    "budget": "node scripts/bundle-budget.mjs",
    "smoke": "node scripts/smoke-extension.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "26.6.6",
    "playwright-core": "1.64.1",
    "turbo": "2.11.10",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24.21.0",
    "pnpm": ">=12.6.0"
  }
}
