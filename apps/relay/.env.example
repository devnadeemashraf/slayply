# Port the relay listens on.
PORT=3000

# "production" requires EXTENSION_IDS. http://localhost:* origins are always allowed (SPEC §5).
NODE_ENV=development

# Comma-separated Chrome extension IDs (32 characters, a-p) allowed to call the relay.
EXTENSION_IDS=

# Number of trusted reverse proxies in front of the relay. 0 uses the socket address.
# Set this to the verified hop count when deployed behind a proxy (Render), or every
# client shares one rate-limit bucket.
TRUST_PROXY_HOPS=0
