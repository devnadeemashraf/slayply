#!/bin/sh
# Refuse any push that updates or deletes main on the remote.
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "ERROR: direct pushes to 'main' are forbidden. Push a <type>/<ID>-<slug> branch and open a PR."
    exit 1
  fi
done
exit 0
