#!/bin/sh
# Enforce Conventional Commits on the subject line only (body lines are free-form).
subject=$(head -n 1 "$1")
pattern='^(feat|fix|docs|style|refactor|perf|test|chore|build|ci|revert)(\([a-zA-Z0-9_/-]+\))?!?: .+$'

case "$subject" in
  Merge\ *|Revert\ \"*) exit 0 ;;
esac

if ! printf '%s\n' "$subject" | grep -Eq "$pattern"; then
  echo "ERROR: commit subject must follow Conventional Commits: <type>(<scope>): <subject>"
  echo "  e.g. feat(core): add Zod request schema"
  echo "Received: $subject"
  exit 1
fi
