// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Badge > always shows its text and carries a tone class 1`] = `"<span class="sl-badge sl-badge-ok">High chance</span>"`;

exports[`Button > is a non-submitting button by default and carries its variant 1`] = `"<button type="button" class="sl-btn sl-btn-secondary">Save</button>"`;

exports[`Card > renders a titled section 1`] = `"<section class="sl-card"><h2 class="sl-card-title">Fit</h2><p>body</p></section>"`;

exports[`Chip > is a toggle button with aria-pressed when clickable 1`] = `"<button type="button" class="sl-chip sl-chip-selected sl-chip-button" aria-pressed="true">Remote</button>"`;

exports[`Chip > is plain text when it has no click handler 1`] = `"<span class="sl-chip">Remote</span>"`;

exports[`EmptyState > shows a title, a body and an optional action 1`] = `"<section class="sl-empty"><h2 class="sl-empty-title">No job yet</h2><p class="sl-empty-body">Open a posting and hit Capture.</p><button type="button" class="sl-btn sl-btn-primary">Capture</button></section>"`;

exports[`Field > marks the input invalid and announces the error 1`] = `"<div class="sl-field"><label class="sl-field-label" for="_R_0_">Key</label><input id="_R_0_" aria-describedby="_R_0_-error" aria-invalid="true" class="sl-field-control"/><p id="_R_0_-error" class="sl-field-error" role="alert">Enter your API key.</p></div>"`;

exports[`Field > ties the label to the input 1`] = `"<div class="sl-field"><label class="sl-field-label" for="_R_0_">Company</label><input id="_R_0_" class="sl-field-control" value="Acme"/></div>"`;

exports[`Switch > exposes role=switch with its state and label 1`] = `"<button type="button" role="switch" aria-checked="true" class="sl-switch"><span class="sl-switch-track" aria-hidden="true"><span class="sl-switch-thumb"></span></span><span>Direct Mode</span></button>"`;

exports[`Tabs > selects one tab and links tabs to panels by id 1`] = `"<div class="sl-tabs" role="tablist" aria-label="Sections"><button type="button" role="tab" class="sl-tab" id="demo-tab-a" aria-selected="false" aria-controls="demo-panel-a" tabindex="-1">Alpha</button><button type="button" role="tab" class="sl-tab" id="demo-tab-b" aria-selected="true" aria-controls="demo-panel-b" tabindex="0">Beta</button><button type="button" role="tab" class="sl-tab" id="demo-tab-c" aria-selected="false" aria-controls="demo-panel-c" tabindex="-1">Gamma</button></div>"`;
