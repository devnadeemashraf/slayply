{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".output/**"]
    },
    "lint": {
      "cache": true
    },
    "fmt:check": {
      "cache": true
    },
    "test": {
      "cache": true
    },
    "check": {
      "dependsOn": ["lint", "fmt:check", "test"],
      "cache": true
    }
  }
}
